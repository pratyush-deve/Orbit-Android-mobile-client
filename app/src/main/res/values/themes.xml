<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.OrbitMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pitch_black</item>
        <item name="android:statusBarColor">@color/pitch_black</item>
        <item name="android:navigationBarColor">@color/pitch_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <!-- Android 12+ (API 31+) Native Splash Screen -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/pitch_black</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/orbit_logo</item>
    </style>
</resources>
